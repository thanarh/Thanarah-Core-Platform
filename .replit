modules = ["nodejs-20"]
[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[userenv]

[userenv.shared]
JWT_EXPIRES_IN = "7d"
NODE_ENV = "development"
PORT = "5000"
THROTTLE_LIMIT = "100"
THROTTLE_TTL = "60000"
JWT_SECRET = "thanarah-development-secret-key-minimum-32-chars-ok"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run build && node dist/main"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 80
