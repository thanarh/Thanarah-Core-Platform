modules = ["web", "nodejs-22", "python-base-3.13"]
[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[userenv]

[userenv.shared]
NODE_ENV = "development"
PORT = "5000"
THROTTLE_LIMIT = "100"
THROTTLE_TTL = "60000"

[userenv.development]
PLATFORM_MONGO_DATABASE = "thanarah_platform_dev_probe"
THANARAH_EMBED_ALLOWED_ORIGINS = "https://thanarah.com,https://68445d38-0ae6-4308-a310-953d54402b3a-00-1bflpp4diulbd.sisko.replit.dev"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npx nest build && node dist/main"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 80
