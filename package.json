{
  "name": "thanarah-backend",
  "version": "0.1.0",
  "description": "Thanarah backend platform",
  "author": "Thanarah Team",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "build": "nest build",
    "start": "node dist/main",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,test}/**/*.ts\" --fix",
    "format": "prettier --write \"{src,test}/**/*.ts\"",
    "format:check": "prettier --check \"{src,test}/**/*.ts\"",
    "type-check": "tsc --noEmit",
    "type-check:tenant-contracts": "tsc --noEmit -p tsconfig.tenant-contracts.json",
    "bootstrap:platform-admin:dev": "bash scripts/bootstrap-platform-admin-dev.sh",
    "test": "vitest run",
    "test:phase30": "npm run build && DOCKER_HOST=unix:///var/run/docker.sock vitest run --config vitest.phase30.config.ts",
    "test:phase42": "npm run build && DOCKER_HOST=unix:///var/run/docker.sock vitest run --config vitest.phase30.config.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/helmet": "^13.1.0",
    "@fastify/static": "^10.1.7",
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/jwt": "^12.0.1",
    "@nestjs/platform-fastify": "^11.2.7",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "^6.19.3",
    "argon2": "^0.41.1",
    "fastify": "^5.12.7",
    "mongodb": "^7.7.0",
    "nestjs-pino": "^4.6.1",
    "pino-http": "^10.5.0",
    "prisma": "^6.19.3",
    "testcontainers": "^12.2.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.1.28",
    "@types/node": "^22.20.1",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "@nestjs/platform-fastify": {
      "fastify": "5.12.7"
    }
  },
  "lint-staged": {
    "{src,test}/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
