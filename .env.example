# Application
NODE_ENV=development
PORT=5000

# Database (MySQL / MariaDB)
# Production (cPanel): mysql://USER:PASS@localhost:3306/thanarah_platform
# Development (Replit): leave unset — the app starts without a live DB connection
DATABASE_URL=

# Authentication
# Required in production. Store this in the hosting environment's secret
# manager; never commit an actual signing secret.
JWT_ACCESS_SECRET=
AUTH_ACCESS_TOKEN_TTL_MINUTES=15
AUTH_REFRESH_TOKEN_TTL_DAYS=30
AUTH_MAX_FAILED_LOGIN_ATTEMPTS=5
AUTH_LOGIN_LOCK_MINUTES=15
AUTH_REFRESH_COOKIE_NAME=thanarah_refresh
AUTH_REFRESH_COOKIE_DOMAIN=
AUTH_REFRESH_COOKIE_SECURE=false
AUTH_REFRESH_COOKIE_SAME_SITE=strict
# Comma-separated trusted reverse-proxy IPs/CIDRs. Never use 0.0.0.0/0.
AUTH_TRUSTED_PROXIES=127.0.0.1,::1

# Rate Limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
