# Application
NODE_ENV=development
PORT=5000

# Database (MySQL / MariaDB)
# Required in production (cPanel): mysql://USER:PASS@localhost:3306/thanarah_platform
# Development (Replit): leave unset — the app starts without a live DB connection
# Development-only external MySQL/MariaDB. Leave blank unless an approved
# non-production database is connected. Replit reserves DATABASE_URL for Postgres.
MYSQL_DATABASE_URL=
# Production/staging MySQL/MariaDB only; production configuration belongs in cPanel.
DATABASE_URL=

# Tenant-owned Patient storage
# Use "memory" only for explicit local development, "mongodb" for persistent storage,
# and keep "disabled" when no tenant storage has been configured.
TENANT_STORAGE_PROVIDER=disabled
# Supply this through the runtime secret manager when TENANT_STORAGE_PROVIDER=mongodb.
TENANT_STORAGE_MONGO_URI=

# AI provider activation
# Hosted inference is off until explicitly approved and a provider secret is configured.
AI_EXTERNAL_INFERENCE_ENABLED=false
AI_OPENAI_BASE_URL=https://api.openai.com/v1
# Store AI_OPENAI_API_KEY in the runtime secret manager; never put its value here.
AI_OLLAMA_ENABLED=false

# Authentication
# Required in production. Store this in the hosting environment's secret
# manager; never commit an actual signing secret.
JWT_ACCESS_SECRET=
AUTH_ACCESS_TOKEN_TTL_MINUTES=15
AUTH_REFRESH_TOKEN_TTL_DAYS=30
AUTH_MAX_FAILED_LOGIN_ATTEMPTS=5
AUTH_LOGIN_LOCK_MINUTES=15
AUTH_REFRESH_COOKIE_NAME=thanarah_refresh
AUTH_REFRESH_COOKIE_DOMAIN=
AUTH_REFRESH_COOKIE_SECURE=false
AUTH_REFRESH_COOKIE_SAME_SITE=strict
# Comma-separated trusted reverse-proxy IPs/CIDRs. Never use 0.0.0.0/0.
AUTH_TRUSTED_PROXIES=127.0.0.1,::1

# Rate Limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
