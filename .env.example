# Application
NODE_ENV=development
PORT=5000

# Database (MySQL / MariaDB)
# Production (cPanel): mysql://USER:PASS@localhost:3306/thanarah_platform
# Development (Replit): leave unset — the app starts without a live DB connection
DATABASE_URL=

# Authentication
JWT_SECRET=change-this-to-a-secure-random-string-of-at-least-32-characters
JWT_EXPIRES_IN=7d

# Rate Limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
