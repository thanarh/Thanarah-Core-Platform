// Thanarah Central Platform — Prisma schema
//
// Target database : MySQL / MariaDB on cPanel
// Database name   : thanarah_platform
//
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum PlatformSessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
  COMPROMISED
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum FacilityStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum BranchStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum StaffStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum PatientStatus {
  ACTIVE
  INACTIVE
}

enum TenantStorageTargetStatus {
  ACTIVE
  INACTIVE
}

enum TenantStorageProvider {
  MONGODB
}

enum TenantCatalogStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum PlanStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum SubscriptionStatus {
  ACTIVE
  SUSPENDED
  CANCELLED
  EXPIRED
}

enum FeatureStatus {
  ACTIVE
  INACTIVE
}

enum TenantMembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REMOVED
}

enum PlatformAuditEventType {
  AUTH_LOGIN_SUCCEEDED
  AUTH_LOGOUT
  AUTH_LOGOUT_ALL
  TENANT_CREATED
  TENANT_STATUS_CHANGED
  TENANT_DEACTIVATED
  TENANT_MEMBERSHIP_INVITED
  TENANT_MEMBERSHIP_ACTIVATED
  TENANT_MEMBERSHIP_SUSPENDED
  TENANT_MEMBERSHIP_REMOVED
  TENANT_ROLE_CREATED
  TENANT_ROLE_UPDATED
  TENANT_ROLE_PERMISSIONS_UPDATED
  TENANT_MEMBERSHIP_ROLE_ASSIGNED
  TENANT_MEMBERSHIP_ROLE_REMOVED
  TENANT_OWNER_ASSIGNED
  TENANT_AUTHORIZATION_DENIED
  FACILITY_CREATED
  FACILITY_UPDATED
  FACILITY_SUSPENDED
  FACILITY_ACTIVATED
  FACILITY_DEACTIVATED
  BRANCH_CREATED
  BRANCH_UPDATED
  BRANCH_SUSPENDED
  BRANCH_ACTIVATED
  BRANCH_DEACTIVATED
  STAFF_CREATED
  STAFF_UPDATED
  STAFF_SUSPENDED
  STAFF_ACTIVATED
  STAFF_DEACTIVATED
  STAFF_ROLE_ASSIGNED
  STAFF_ROLE_REMOVED
  STAFF_FACILITY_ASSIGNED
  STAFF_FACILITY_UNASSIGNED
  STAFF_BRANCH_ASSIGNED
  STAFF_BRANCH_UNASSIGNED
  DEPARTMENT_CREATED
  DEPARTMENT_UPDATED
  DEPARTMENT_ACTIVATED
  DEPARTMENT_SUSPENDED
  DEPARTMENT_DEACTIVATED
  SPECIALTY_CREATED
  SPECIALTY_UPDATED
  SPECIALTY_ACTIVATED
  SPECIALTY_SUSPENDED
  SPECIALTY_DEACTIVATED
  SERVICE_CREATED
  SERVICE_UPDATED
  SERVICE_STATUS_CHANGED
  DOCTOR_CREATED
  DOCTOR_UPDATED
  DOCTOR_ACTIVATED
  DOCTOR_SUSPENDED
  DOCTOR_DEACTIVATED
  DOCTOR_DEPARTMENT_ASSIGNED
  DOCTOR_DEPARTMENT_UNASSIGNED
  DOCTOR_SPECIALTY_ASSIGNED
  DOCTOR_SPECIALTY_UNASSIGNED
  PATIENT_CREATED
  PATIENT_UPDATED
  PATIENT_STATUS_CHANGED
  APPOINTMENT_CREATED
  APPOINTMENT_UPDATED
  APPOINTMENT_RESCHEDULED
  APPOINTMENT_CANCELLED
  ENCOUNTER_CREATED
  ENCOUNTER_CLINICAL_UPDATED
  ENCOUNTER_COMPLETED
  ENCOUNTER_CANCELLED
  SCHEDULING_POLICY_CREATED
  SCHEDULING_POLICY_UPDATED
  SCHEDULING_POLICY_ACTIVATED
  SCHEDULING_POLICY_DEACTIVATED
  PLAN_CREATED
  PLAN_UPDATED
  PLAN_ACTIVATED
  PLAN_DEACTIVATED
  PLAN_ARCHIVED
  FEATURE_CREATED
  FEATURE_UPDATED
  FEATURE_ACTIVATED
  FEATURE_DEACTIVATED
  PLAN_FEATURE_ATTACHED
  PLAN_FEATURE_UPDATED
  PLAN_FEATURE_DETACHED
  SUBSCRIPTION_CREATED
  SUBSCRIPTION_ACTIVATED
  SUBSCRIPTION_SUSPENDED
  SUBSCRIPTION_CANCELLED
  SUBSCRIPTION_EXPIRED
}

enum FacilitySchedulingPolicyStatus {
  INACTIVE
  ACTIVE
}

enum FacilitySchedulingPolicyRevisionAction {
  CREATED
  UPDATED
  ACTIVATED
  DEACTIVATED
}

enum PlatformSecurityEventType {
  AUTH_LOGIN_FAILED
  AUTH_ACCOUNT_LOCKED
  AUTH_REFRESH_TOKEN_REUSE
  AUTH_REFRESH_SESSION_COMPROMISED
  AUTHORIZATION_DENIED
}

enum PlatformSecurityEventStatus {
  OPEN
  RESOLVED
}

enum EncounterOperationStatus {
  PENDING
  FAILED
  DELIVERED
  RECONCILED
  REVIEW_REQUIRED
}

model User {
  id                    String                  @id @default(uuid()) @db.Char(36)
  email                 String                  @unique @db.VarChar(254)
  passwordHash          String                  @db.VarChar(255)
  fullName              String                  @db.VarChar(191)
  status                UserStatus              @default(ACTIVE)
  tokenVersion          Int                     @default(0)
  failedLoginAttempts   Int                     @default(0)
  lockedUntil           DateTime?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  sessions              PlatformSession[]
  platformRoles         UserPlatformRole[]
  auditActorRecords     PlatformAuditLog[]      @relation("PlatformAuditActor")
  auditSubjectRecords   PlatformAuditLog[]      @relation("PlatformAuditSubject")
  securityActorEvents   PlatformSecurityEvent[] @relation("PlatformSecurityActor")
  securitySubjectEvents PlatformSecurityEvent[] @relation("PlatformSecuritySubject")
  securityResolutions   PlatformSecurityEvent[] @relation("PlatformSecurityResolver")
  tenantMemberships     TenantMembership[]      @relation("TenantMembershipPlatformUser")
  staffProfiles         Staff[]                 @relation("StaffPlatformUser")

  @@index([status])
}

model PlatformRole {
  id          String                   @id @default(uuid()) @db.Char(36)
  code        String                   @unique @db.VarChar(64)
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  users       UserPlatformRole[]
  permissions PlatformRolePermission[]
}

model PlatformPermission {
  id        String                   @id @default(uuid()) @db.Char(36)
  code      String                   @unique @db.VarChar(128)
  createdAt DateTime                 @default(now())
  updatedAt DateTime                 @updatedAt
  roles     PlatformRolePermission[]
}

model UserPlatformRole {
  userId String       @db.Char(36)
  roleId String       @db.Char(36)
  user   User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  role   PlatformRole @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([roleId])
}

model PlatformRolePermission {
  roleId       String             @db.Char(36)
  permissionId String             @db.Char(36)
  role         PlatformRole       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  permission   PlatformPermission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model PlatformSession {
  id               String                        @id @default(uuid()) @db.Char(36)
  userId           String                        @db.Char(36)
  refreshTokenHash String                        @unique @db.Char(64)
  tokenFamilyId    String                        @db.Char(36)
  status           PlatformSessionStatus         @default(ACTIVE)
  ipAddress        String?                       @db.VarChar(45)
  userAgent        String?                       @db.VarChar(512)
  deviceName       String?                       @db.VarChar(191)
  deviceType       String?                       @db.VarChar(64)
  browser          String?                       @db.VarChar(128)
  operatingSystem  String?                       @db.VarChar(128)
  countryCode      String?                       @db.Char(2)
  createdAt        DateTime                      @default(now())
  lastActivityAt   DateTime                      @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?
  revokedBy        String?                       @db.Char(36)
  revocationReason String?                       @db.VarChar(255)
  user             User                          @relation(fields: [userId], references: [id], onDelete: Restrict)
  refreshHistory   PlatformRefreshTokenHistory[]

  @@index([userId, status])
  @@index([tokenFamilyId])
  @@index([expiresAt])
}

model PlatformRefreshTokenHistory {
  id              String          @id @default(uuid()) @db.Char(36)
  sessionId       String          @db.Char(36)
  tokenFamilyId   String          @db.Char(36)
  tokenHash       String          @unique @db.Char(64)
  rotatedAt       DateTime        @default(now())
  expiresAt       DateTime
  reuseDetectedAt DateTime?
  session         PlatformSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  @@index([sessionId])
  @@index([tokenFamilyId])
  @@index([expiresAt])
}

model Tenant {
  id                         String                     @id @default(uuid()) @db.Char(36)
  slug                       String                     @unique @db.VarChar(64)
  legalName                  String                     @db.VarChar(191)
  displayName                String                     @db.VarChar(191)
  status                     TenantStatus               @default(ACTIVE)
  statusChangedAt            DateTime                   @default(now())
  suspendedAt                DateTime?
  deactivatedAt              DateTime?
  createdAt                  DateTime                   @default(now())
  updatedAt                  DateTime                   @updatedAt
  auditEvents                PlatformAuditLog[]         @relation("TenantAuditSubject")
  facilities                 Facility[]
  staff                      Staff[]                    @relation("TenantStaffTenant")
  departments                Department[]
  specialties                Specialty[]
  services                   Service[]
  doctors                    Doctor[]
  patients                   Patient[]
  storageTargets             TenantStorageTarget[]
  memberships                TenantMembership[]         @relation("TenantMembershipTenant")
  roles                      TenantRole[]
  subscriptions              Subscription[]
  facilitySchedulingPolicies FacilitySchedulingPolicy[]

  @@index([status])
  @@index([status, createdAt])
}

model Facility {
  id                     String                    @id @default(uuid()) @db.Char(36)
  tenantId               String                    @db.Char(36)
  name                   String                    @db.VarChar(191)
  status                 FacilityStatus            @default(ACTIVE)
  statusChangedAt        DateTime                  @default(now())
  suspendedAt            DateTime?
  deactivatedAt          DateTime?
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt
  tenant                 Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branches               Branch[]
  staffAssignments       StaffFacilityAssignment[]
  staffBranchAssignments StaffBranchAssignment[]   @relation("StaffBranchAssignmentFacility")
  schedulingPolicy       FacilitySchedulingPolicy?

  @@unique([id, tenantId])
  @@index([tenantId, status, createdAt])
}

model FacilitySchedulingPolicy {
  id         String                             @id @default(uuid()) @db.Char(36)
  tenantId   String                             @db.Char(36)
  facilityId String                             @db.Char(36)
  status     FacilitySchedulingPolicyStatus     @default(INACTIVE)
  timeZone   String                             @db.VarChar(64)
  rules      Json
  version    Int                                @default(1)
  createdAt  DateTime                           @default(now())
  updatedAt  DateTime                           @updatedAt
  tenant     Tenant                             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  facility   Facility                           @relation(fields: [facilityId, tenantId], references: [id, tenantId], onDelete: Restrict)
  revisions  FacilitySchedulingPolicyRevision[]

  @@unique([facilityId, tenantId])
  @@unique([id, tenantId])
  @@index([tenantId, status])
}

model FacilitySchedulingPolicyRevision {
  id          String                                 @id @default(uuid()) @db.Char(36)
  policyId    String                                 @db.Char(36)
  tenantId    String                                 @db.Char(36)
  facilityId  String                                 @db.Char(36)
  version     Int
  action      FacilitySchedulingPolicyRevisionAction
  status      FacilitySchedulingPolicyStatus
  timeZone    String                                 @db.VarChar(64)
  rules       Json
  actorUserId String                                 @db.Char(36)
  createdAt   DateTime                               @default(now())
  policy      FacilitySchedulingPolicy               @relation(fields: [policyId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([policyId, version])
  @@index([tenantId, facilityId, createdAt], map: "FacilitySchedPolicyRevision_tenant_fac_created_idx")
}

model Branch {
  id               String                  @id @default(uuid()) @db.Char(36)
  facilityId       String                  @db.Char(36)
  name             String                  @db.VarChar(191)
  status           BranchStatus            @default(ACTIVE)
  statusChangedAt  DateTime                @default(now())
  suspendedAt      DateTime?
  deactivatedAt    DateTime?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  facility         Facility                @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  staffAssignments StaffBranchAssignment[]

  @@unique([id, facilityId])
  @@index([facilityId, status, createdAt])
}

model Staff {
  id                  String                    @id @default(uuid()) @db.Char(36)
  tenantId            String                    @db.Char(36)
  userId              String                    @db.Char(36)
  membershipId        String                    @db.Char(36)
  displayName         String                    @db.VarChar(191)
  jobTitle            String?                   @db.VarChar(191)
  status              StaffStatus               @default(ACTIVE)
  statusChangedAt     DateTime                  @default(now())
  suspendedAt         DateTime?
  deactivatedAt       DateTime?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  tenant              Tenant                    @relation("TenantStaffTenant", fields: [tenantId], references: [id], onDelete: Restrict)
  platformUser        User                      @relation("StaffPlatformUser", fields: [userId], references: [id], onDelete: Restrict)
  membership          TenantMembership          @relation("TenantStaffMembership", fields: [membershipId, tenantId, userId], references: [id, tenantId, platformUserId], onDelete: Restrict)
  roleAssignments     StaffRoleAssignment[]
  facilityAssignments StaffFacilityAssignment[]
  branchAssignments   StaffBranchAssignment[]
  doctor              Doctor?

  @@unique([id, tenantId])
  @@unique([tenantId, userId])
  @@unique([membershipId, tenantId, userId])
  @@index([tenantId, status, createdAt])
  @@index([userId, status])
}

model TenantMembership {
  id              String                 @id @default(uuid()) @db.Char(36)
  tenantId        String                 @db.Char(36)
  platformUserId  String                 @db.Char(36)
  status          TenantMembershipStatus @default(INVITED)
  statusChangedAt DateTime               @default(now())
  activatedAt     DateTime?
  suspendedAt     DateTime?
  removedAt       DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  tenant          Tenant                 @relation("TenantMembershipTenant", fields: [tenantId], references: [id], onDelete: Restrict)
  platformUser    User                   @relation("TenantMembershipPlatformUser", fields: [platformUserId], references: [id], onDelete: Restrict)
  roleAssignments TenantMembershipRole[]
  staffProfile    Staff?                 @relation("TenantStaffMembership")

  @@unique([tenantId, platformUserId])
  @@unique([id, tenantId])
  @@unique([id, tenantId, platformUserId])
  @@index([tenantId, status, createdAt])
  @@index([platformUserId, status])
}

model TenantPermission {
  id          String                 @id @default(uuid()) @db.Char(36)
  code        String                 @unique @db.VarChar(128)
  description String                 @db.VarChar(255)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  roles       TenantRolePermission[]
}

model TenantRole {
  id                String                 @id @default(uuid()) @db.Char(36)
  tenantId          String                 @db.Char(36)
  code              String                 @db.VarChar(64)
  name              String                 @db.VarChar(128)
  description       String?                @db.VarChar(512)
  isSystemRole      Boolean                @default(false)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  tenant            Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  permissions       TenantRolePermission[]
  memberAssignments TenantMembershipRole[]
  staffAssignments  StaffRoleAssignment[]

  @@unique([tenantId, code])
  @@unique([id, tenantId])
  @@index([tenantId, isSystemRole])
}

model TenantRolePermission {
  tenantRoleId       String           @db.Char(36)
  tenantPermissionId String           @db.Char(36)
  assignedAt         DateTime         @default(now())
  role               TenantRole       @relation(fields: [tenantRoleId], references: [id], onDelete: Restrict)
  permission         TenantPermission @relation(fields: [tenantPermissionId], references: [id], onDelete: Restrict)

  @@id([tenantRoleId, tenantPermissionId])
  @@index([tenantPermissionId])
}

model TenantMembershipRole {
  tenantId     String           @db.Char(36)
  membershipId String           @db.Char(36)
  tenantRoleId String           @db.Char(36)
  assignedAt   DateTime         @default(now())
  membership   TenantMembership @relation(fields: [membershipId, tenantId], references: [id, tenantId], onDelete: Restrict)
  role         TenantRole       @relation(fields: [tenantRoleId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@id([membershipId, tenantRoleId])
  @@index([tenantId, tenantRoleId])
}

model StaffRoleAssignment {
  tenantId     String     @db.Char(36)
  staffId      String     @db.Char(36)
  tenantRoleId String     @db.Char(36)
  assignedAt   DateTime   @default(now())
  staff        Staff      @relation(fields: [staffId, tenantId], references: [id, tenantId], onDelete: Restrict)
  role         TenantRole @relation(fields: [tenantRoleId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@id([staffId, tenantRoleId])
  @@index([tenantId, staffId])
  @@index([tenantId, tenantRoleId])
}

model StaffFacilityAssignment {
  tenantId   String   @db.Char(36)
  staffId    String   @db.Char(36)
  facilityId String   @db.Char(36)
  assignedAt DateTime @default(now())
  staff      Staff    @relation(fields: [staffId, tenantId], references: [id, tenantId], onDelete: Restrict)
  facility   Facility @relation(fields: [facilityId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@id([staffId, facilityId])
  @@index([staffId, tenantId])
  @@index([facilityId, tenantId])
}

model StaffBranchAssignment {
  tenantId   String   @db.Char(36)
  staffId    String   @db.Char(36)
  /// Derived from Branch.facilityId; retained to enforce tenant and parent-facility integrity.
  facilityId String   @db.Char(36)
  branchId   String   @db.Char(36)
  assignedAt DateTime @default(now())
  staff      Staff    @relation(fields: [staffId, tenantId], references: [id, tenantId], onDelete: Restrict)
  facility   Facility @relation("StaffBranchAssignmentFacility", fields: [facilityId, tenantId], references: [id, tenantId], onDelete: Restrict)
  branch     Branch   @relation(fields: [branchId, facilityId], references: [id, facilityId], onDelete: Restrict)

  @@id([staffId, branchId])
  @@index([staffId, tenantId])
  @@index([facilityId, tenantId])
  @@index([branchId, facilityId])
}

model Department {
  id                String                       @id @default(uuid()) @db.Char(36)
  tenantId          String                       @db.Char(36)
  name              String                       @db.VarChar(191)
  description       String?                      @db.VarChar(512)
  status            TenantCatalogStatus          @default(ACTIVE)
  statusChangedAt   DateTime                     @default(now())
  suspendedAt       DateTime?
  deactivatedAt     DateTime?
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt
  tenant            Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  doctorAssignments DoctorDepartmentAssignment[]

  @@unique([id, tenantId])
  @@unique([tenantId, name])
  @@index([tenantId, status, createdAt])
}

model Specialty {
  id                String                      @id @default(uuid()) @db.Char(36)
  tenantId          String                      @db.Char(36)
  name              String                      @db.VarChar(191)
  description       String?                     @db.VarChar(512)
  status            TenantCatalogStatus         @default(ACTIVE)
  statusChangedAt   DateTime                    @default(now())
  suspendedAt       DateTime?
  deactivatedAt     DateTime?
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt
  tenant            Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  doctorAssignments DoctorSpecialtyAssignment[]

  @@unique([id, tenantId])
  @@unique([tenantId, name])
  @@index([tenantId, status, createdAt])
}

model Service {
  id              String              @id @default(uuid()) @db.Char(36)
  tenantId        String              @db.Char(36)
  name            String              @db.VarChar(191)
  code            String?             @db.VarChar(64)
  description     String?             @db.VarChar(2000)
  status          TenantCatalogStatus @default(ACTIVE)
  statusChangedAt DateTime            @default(now())
  suspendedAt     DateTime?
  deactivatedAt   DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([id, tenantId])
  @@unique([tenantId, name])
  @@unique([tenantId, code])
  @@index([tenantId, createdAt])
  @@index([tenantId, status, createdAt])
}

model Patient {
  id            String        @id @default(uuid()) @db.Char(36)
  tenantId      String        @db.Char(36)
  patientNumber String        @db.VarChar(64)
  firstName     String        @db.VarChar(191)
  middleName    String?       @db.VarChar(191)
  lastName      String        @db.VarChar(191)
  preferredName String?       @db.VarChar(191)
  dateOfBirth   DateTime?     @db.Date
  gender        String?       @db.VarChar(32)
  phone         String?       @db.VarChar(32)
  email         String?       @db.VarChar(191)
  nationalId    String?       @db.VarChar(64)
  address       String?       @db.VarChar(2000)
  status        PatientStatus @default(ACTIVE)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([id, tenantId])
  @@unique([tenantId, patientNumber])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, createdAt])
}

model TenantStorageTarget {
  id                  String                    @id @default(uuid()) @db.Char(36)
  tenantId            String                    @db.Char(36)
  provider            TenantStorageProvider     @default(MONGODB)
  connectionReference String                    @default("primary") @db.VarChar(64)
  databaseName        String                    @db.VarChar(63)
  status              TenantStorageTargetStatus @default(INACTIVE)
  isPrimary           Boolean                   @default(false)
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  tenant              Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([connectionReference, databaseName])
  @@index([tenantId, status, isPrimary, createdAt])
  @@index([provider, status])
}

model Doctor {
  id                      String                       @id @default(uuid()) @db.Char(36)
  tenantId                String                       @db.Char(36)
  staffId                 String                       @db.Char(36)
  professionalDisplayName String?                      @db.VarChar(191)
  professionalTitle       String?                      @db.VarChar(191)
  professionalCode        String?                      @db.VarChar(64)
  bio                     String?                      @db.VarChar(2000)
  status                  StaffStatus                  @default(ACTIVE)
  statusChangedAt         DateTime                     @default(now())
  suspendedAt             DateTime?
  deactivatedAt           DateTime?
  createdAt               DateTime                     @default(now())
  updatedAt               DateTime                     @updatedAt
  tenant                  Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  staff                   Staff                        @relation(fields: [staffId, tenantId], references: [id, tenantId], onDelete: Restrict)
  departmentAssignments   DoctorDepartmentAssignment[]
  specialtyAssignments    DoctorSpecialtyAssignment[]

  @@unique([id, tenantId])
  @@unique([staffId, tenantId])
  @@unique([tenantId, professionalCode])
  @@index([tenantId, status, createdAt])
}

model DoctorDepartmentAssignment {
  tenantId     String     @db.Char(36)
  doctorId     String     @db.Char(36)
  departmentId String     @db.Char(36)
  createdAt    DateTime   @default(now())
  doctor       Doctor     @relation(fields: [doctorId, tenantId], references: [id, tenantId], onDelete: Restrict)
  department   Department @relation(fields: [departmentId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@id([doctorId, departmentId])
  @@index([doctorId, tenantId])
  @@index([departmentId, tenantId])
}

model DoctorSpecialtyAssignment {
  tenantId    String    @db.Char(36)
  doctorId    String    @db.Char(36)
  specialtyId String    @db.Char(36)
  createdAt   DateTime  @default(now())
  doctor      Doctor    @relation(fields: [doctorId, tenantId], references: [id, tenantId], onDelete: Restrict)
  specialty   Specialty @relation(fields: [specialtyId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@id([doctorId, specialtyId])
  @@index([doctorId, tenantId])
  @@index([specialtyId, tenantId])
}

model Plan {
  id              String         @id @default(uuid()) @db.Char(36)
  key             String         @unique @db.VarChar(64)
  name            String         @db.VarChar(191)
  description     String?        @db.VarChar(1000)
  status          PlanStatus     @default(ACTIVE)
  statusChangedAt DateTime       @default(now())
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  features        PlanFeature[]
  subscriptions   Subscription[]

  @@index([status, createdAt])
}

model Feature {
  id              String        @id @default(uuid()) @db.Char(36)
  key             String        @unique @db.VarChar(64)
  name            String        @db.VarChar(191)
  description     String?       @db.VarChar(1000)
  status          FeatureStatus @default(ACTIVE)
  statusChangedAt DateTime      @default(now())
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  plans           PlanFeature[]

  @@index([status, createdAt])
}

model PlanFeature {
  planId      String   @db.Char(36)
  featureId   String   @db.Char(36)
  enabled     Boolean  @default(true)
  quotaLimits Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  plan        Plan     @relation(fields: [planId], references: [id], onDelete: Restrict)
  feature     Feature  @relation(fields: [featureId], references: [id], onDelete: Restrict)

  @@id([planId, featureId])
  @@index([featureId, createdAt])
}

model Subscription {
  id          String             @id @default(uuid()) @db.Char(36)
  tenantId    String             @db.Char(36)
  planId      String             @db.Char(36)
  status      SubscriptionStatus @default(ACTIVE)
  startsAt    DateTime
  endsAt      DateTime?
  cancelledAt DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  plan        Plan               @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([tenantId, status, startsAt, endsAt])
  @@index([planId, createdAt])
}

model PlatformAuditLog {
  id              String                 @id @default(uuid()) @db.Char(36)
  eventType       PlatformAuditEventType
  actorUserId     String?                @db.Char(36)
  subjectUserId   String?                @db.Char(36)
  subjectTenantId String?                @db.Char(36)
  sessionId       String?                @db.Char(36)
  requestId       String?                @db.VarChar(128)
  ipAddress       String?                @db.VarChar(45)
  userAgent       String?                @db.VarChar(512)
  metadata        Json?
  occurredAt      DateTime               @default(now())
  actor           User?                  @relation("PlatformAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  subject         User?                  @relation("PlatformAuditSubject", fields: [subjectUserId], references: [id], onDelete: SetNull)
  subjectTenant   Tenant?                @relation("TenantAuditSubject", fields: [subjectTenantId], references: [id], onDelete: SetNull)

  @@index([eventType, occurredAt])
  @@index([actorUserId, occurredAt])
  @@index([subjectUserId, occurredAt])
  @@index([subjectTenantId, occurredAt])
  @@index([sessionId, occurredAt])
}

model EncounterOperation {
  id                        String                   @id @db.Char(36)
  tenantId                  String                   @db.Char(36)
  resourceType              String                   @db.VarChar(32)
  resourceId                String                   @db.Char(36)
  operationType             String                   @db.VarChar(64)
  actorUserId               String?                  @db.Char(36)
  historyEventId            String                   @unique @db.Char(36)
  auditEventType            String                   @db.VarChar(64)
  auditMetadata             Json
  auditDeliveryStatus       EncounterOperationStatus @default(PENDING)
  attemptCount              Int                      @default(0)
  lastAttemptAt             DateTime?
  lastFailureClassification String?                  @db.VarChar(64)
  reconciliationOutcome     String?                  @db.VarChar(64)
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt

  @@index([tenantId, auditDeliveryStatus, createdAt])
  @@index([auditDeliveryStatus, createdAt])
}

model PlatformSecurityEvent {
  id             String                      @id @default(uuid()) @db.Char(36)
  eventType      PlatformSecurityEventType
  status         PlatformSecurityEventStatus @default(OPEN)
  actorUserId    String?                     @db.Char(36)
  subjectUserId  String?                     @db.Char(36)
  sessionId      String?                     @db.Char(36)
  requestId      String?                     @db.VarChar(128)
  ipAddress      String?                     @db.VarChar(45)
  userAgent      String?                     @db.VarChar(512)
  metadata       Json?
  occurredAt     DateTime                    @default(now())
  resolvedAt     DateTime?
  resolvedBy     String?                     @db.Char(36)
  resolutionNote String?                     @db.VarChar(1000)
  updatedAt      DateTime                    @updatedAt
  actor          User?                       @relation("PlatformSecurityActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  subject        User?                       @relation("PlatformSecuritySubject", fields: [subjectUserId], references: [id], onDelete: SetNull)
  resolver       User?                       @relation("PlatformSecurityResolver", fields: [resolvedBy], references: [id], onDelete: SetNull)

  @@index([eventType, status, occurredAt])
  @@index([actorUserId, occurredAt])
  @@index([subjectUserId, occurredAt])
  @@index([sessionId, occurredAt])
}
