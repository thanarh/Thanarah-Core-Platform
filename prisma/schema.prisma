// Thanarah Central Platform — Prisma schema
//
// Target database : MySQL / MariaDB on cPanel
// Database name   : thanarah_platform
//
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum PlatformSessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
  COMPROMISED
}

enum PlatformAuditEventType {
  AUTH_LOGIN_SUCCEEDED
  AUTH_LOGOUT
  AUTH_LOGOUT_ALL
}

enum PlatformSecurityEventType {
  AUTH_LOGIN_FAILED
  AUTH_ACCOUNT_LOCKED
  AUTH_REFRESH_TOKEN_REUSE
  AUTH_REFRESH_SESSION_COMPROMISED
  AUTHORIZATION_DENIED
}

enum PlatformSecurityEventStatus {
  OPEN
  RESOLVED
}

model User {
  id                    String                  @id @default(uuid()) @db.Char(36)
  email                 String                  @unique @db.VarChar(254)
  passwordHash          String                  @db.VarChar(255)
  fullName              String                  @db.VarChar(191)
  status                UserStatus              @default(ACTIVE)
  tokenVersion          Int                     @default(0)
  failedLoginAttempts   Int                     @default(0)
  lockedUntil           DateTime?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  sessions              PlatformSession[]
  platformRoles         UserPlatformRole[]
  auditActorRecords     PlatformAuditLog[]      @relation("PlatformAuditActor")
  auditSubjectRecords   PlatformAuditLog[]      @relation("PlatformAuditSubject")
  securityActorEvents   PlatformSecurityEvent[] @relation("PlatformSecurityActor")
  securitySubjectEvents PlatformSecurityEvent[] @relation("PlatformSecuritySubject")
  securityResolutions   PlatformSecurityEvent[] @relation("PlatformSecurityResolver")

  @@index([status])
}

model PlatformRole {
  id          String                   @id @default(uuid()) @db.Char(36)
  code        String                   @unique @db.VarChar(64)
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  users       UserPlatformRole[]
  permissions PlatformRolePermission[]
}

model PlatformPermission {
  id        String                   @id @default(uuid()) @db.Char(36)
  code      String                   @unique @db.VarChar(128)
  createdAt DateTime                 @default(now())
  updatedAt DateTime                 @updatedAt
  roles     PlatformRolePermission[]
}

model UserPlatformRole {
  userId String       @db.Char(36)
  roleId String       @db.Char(36)
  user   User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  role   PlatformRole @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([roleId])
}

model PlatformRolePermission {
  roleId       String             @db.Char(36)
  permissionId String             @db.Char(36)
  role         PlatformRole       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  permission   PlatformPermission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model PlatformSession {
  id               String                        @id @default(uuid()) @db.Char(36)
  userId           String                        @db.Char(36)
  refreshTokenHash String                        @unique @db.Char(64)
  tokenFamilyId    String                        @db.Char(36)
  status           PlatformSessionStatus         @default(ACTIVE)
  ipAddress        String?                       @db.VarChar(45)
  userAgent        String?                       @db.VarChar(512)
  deviceName       String?                       @db.VarChar(191)
  deviceType       String?                       @db.VarChar(64)
  browser          String?                       @db.VarChar(128)
  operatingSystem  String?                       @db.VarChar(128)
  countryCode      String?                       @db.Char(2)
  createdAt        DateTime                      @default(now())
  lastActivityAt   DateTime                      @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?
  revokedBy        String?                       @db.Char(36)
  revocationReason String?                       @db.VarChar(255)
  user             User                          @relation(fields: [userId], references: [id], onDelete: Restrict)
  refreshHistory   PlatformRefreshTokenHistory[]

  @@index([userId, status])
  @@index([tokenFamilyId])
  @@index([expiresAt])
}

model PlatformRefreshTokenHistory {
  id              String          @id @default(uuid()) @db.Char(36)
  sessionId       String          @db.Char(36)
  tokenFamilyId   String          @db.Char(36)
  tokenHash       String          @unique @db.Char(64)
  rotatedAt       DateTime        @default(now())
  expiresAt       DateTime
  reuseDetectedAt DateTime?
  session         PlatformSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  @@index([sessionId])
  @@index([tokenFamilyId])
  @@index([expiresAt])
}

model PlatformAuditLog {
  id            String                 @id @default(uuid()) @db.Char(36)
  eventType     PlatformAuditEventType
  actorUserId   String?                @db.Char(36)
  subjectUserId String?                @db.Char(36)
  sessionId     String?                @db.Char(36)
  requestId     String?                @db.VarChar(128)
  ipAddress     String?                @db.VarChar(45)
  userAgent     String?                @db.VarChar(512)
  metadata      Json?
  occurredAt    DateTime               @default(now())
  actor         User?                  @relation("PlatformAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  subject       User?                  @relation("PlatformAuditSubject", fields: [subjectUserId], references: [id], onDelete: SetNull)

  @@index([eventType, occurredAt])
  @@index([actorUserId, occurredAt])
  @@index([subjectUserId, occurredAt])
  @@index([sessionId, occurredAt])
}

model PlatformSecurityEvent {
  id             String                      @id @default(uuid()) @db.Char(36)
  eventType      PlatformSecurityEventType
  status         PlatformSecurityEventStatus @default(OPEN)
  actorUserId    String?                     @db.Char(36)
  subjectUserId  String?                     @db.Char(36)
  sessionId      String?                     @db.Char(36)
  requestId      String?                     @db.VarChar(128)
  ipAddress      String?                     @db.VarChar(45)
  userAgent      String?                     @db.VarChar(512)
  metadata       Json?
  occurredAt     DateTime                    @default(now())
  resolvedAt     DateTime?
  resolvedBy     String?                     @db.Char(36)
  resolutionNote String?                     @db.VarChar(1000)
  updatedAt      DateTime                    @updatedAt
  actor          User?                       @relation("PlatformSecurityActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  subject        User?                       @relation("PlatformSecuritySubject", fields: [subjectUserId], references: [id], onDelete: SetNull)
  resolver       User?                       @relation("PlatformSecurityResolver", fields: [resolvedBy], references: [id], onDelete: SetNull)

  @@index([eventType, status, occurredAt])
  @@index([actorUserId, occurredAt])
  @@index([subjectUserId, occurredAt])
  @@index([sessionId, occurredAt])
}
